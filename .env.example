# 複製成 .env 後填入密碼：
#   Copy-Item .env.example .env      （PowerShell）
#   cp .env.example .env             （bash）
# .env 已列在 .gitignore，不會進版控。

# SQL Server 的 SA 密碼（必填）
# 規則：至少 8 碼，且包含大寫、小寫、數字、符號其中三類，否則 SQL Server 容器會啟動失敗。
# 請勿使用 ; 與 $：; 會切斷連線字串，$ 會被 Compose 當成變數。
MSSQL_SA_PASSWORD=

# 主機上對外的埠（可選）
SQL_HOST_PORT=14330
API_HOST_PORT=8080
